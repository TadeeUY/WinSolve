<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\winsolve.ico</ApplicationIcon>
    <AssemblyName>WinSolve</AssemblyName>
    <RootNamespace>WinSolve</RootNamespace>
    <Version>0.5.0</Version>
    <Product>WinSolve</Product>
    <Description>Diagnóstico, reparación y optimización de Windows</Description>
    <Company>WinSolve</Company>
    <Copyright>WinSolve</Copyright>

    <!-- App liviana: un solo .exe pequeño que usa el .NET 8 Desktop Runtime instalado. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- Menos memoria en reposo (la app pasa mucho tiempo en la bandeja). -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
  </PropertyGroup>

  <!--
    La UI está hecha en Windows Forms 100% en código (sin diseñador), así que
    alcanza con referenciar el framework de escritorio. Compila tanto en Windows
    como en Linux/CI gracias a EnableWindowsTargeting.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <Using Include="System.Windows.Forms" />
    <Using Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WinSolve.Tests" />
    <EmbeddedResource Include="..\..\assets\winsolve.ico" LogicalName="WinSolve.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Diagnostics.EventLog" Version="8.0.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
